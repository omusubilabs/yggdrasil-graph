---
/**
 * Japanese entity pages.
 *
 * Chrome renders in Japanese; the prose falls back to English, because
 * entities.json has not been translated yet. That is the partial locale doing
 * its job — the plumbing is exercised by real content in two languages rather
 * than by a placeholder, and the gap is visible instead of hidden.
 */
import '../../../styles/fonts-ja.css';
import type { GetStaticPaths } from 'astro';
import graph from '../../../generated/graph.json';
import type { GraphData } from '../../../graph/types.ts';
import Base from '../../../layouts/Base.astro';
import EntityView from '../../../components/EntityView.astro';
import { useTranslations } from '../../../i18n/index.ts';

export const getStaticPaths: GetStaticPaths = () =>
  (graph as unknown as GraphData).nodes.map((node) => ({ params: { id: node.id } }));

const locale = 'ja' as const;
const t = useTranslations(locale);
const { id } = Astro.params;
const entityId = id!;
const node = (graph as unknown as GraphData).nodes.find((n) => n.id === entityId)!;
---

<Base
  locale={locale}
  route={`/entity/${entityId}`}
  title={t('entity.metaTitle', { name: `${node.names.non} · ${node.names.anglicized}` })}
  description={t(`entity.${entityId}.summary`)}
>
  <EntityView locale={locale} entityId={entityId} />
</Base>
