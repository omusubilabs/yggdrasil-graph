---
/**
 * A relation's citations, rendered as apparatus.
 *
 * An empty list is not a gap to hide — it is the dataset saying, in the only
 * way it is allowed to, that nobody has confirmed a locus for this claim.
 */
import graph from '../generated/graph.json';
import type { GraphData, SourceRef } from '../graph/types.ts';
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  sources: SourceRef[];
}

const { locale, sources } = Astro.props;
const t = useTranslations(locale);
const data = graph as unknown as GraphData;
const byId = new Map(data.sources.map((s) => [s.id, s]));
---

{
  sources.length === 0 ? (
    <span class="apparatus citations__none">{t('sources.uncited')}</span>
  ) : (
    <ul class="citations">
      {sources.map((ref) => {
        const work = byId.get(ref.work);
        const unit = work?.locusUnit === 'stanza' ? 'sources.stanza' : 'sources.chapter';
        return (
          <li class="apparatus">
            {/* i18n-ignore: work titles are Old Norse data from data/sources.json */}
            <span class="citations__work">{work?.titles.non ?? ref.work}</span>
            <span class="citations__locus">{t(unit, { locus: ref.locus })}</span>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .citations {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
  }

  .citations li {
    display: inline-flex;
    gap: 0.35em;
    padding: 0.05em 0.4em;
    background: var(--vellum-deep);
    border-radius: var(--radius-sm);
  }

  .citations__work {
    color: var(--ink);
  }

  .citations__none {
    font-style: italic;
  }
</style>
