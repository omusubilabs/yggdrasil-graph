---
/**
 * Zoom, recentre, the disputed-relations filter, and the Ragnarök overlay.
 *
 * Every one of these needs the runtime, so the whole block stays hidden until
 * the runtime marks itself ready. Rendering a dead button that a reader can
 * press and watch do nothing is worse than rendering nothing.
 */
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="controls" data-graph-controls>
  <div class="controls__search">
    <label for="graph-entity-search">{t('graph.searchLabel')}</label>
    <input
      id="graph-entity-search"
      type="search"
      autocomplete="off"
      placeholder={t('graph.searchPlaceholder')}
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="graph-search-results"
      data-entity-search
    />
    <ul id="graph-search-results" class="controls__results" role="listbox" hidden></ul>
  </div>

  <div class="controls__group" role="group" aria-label={t('graph.zoomControls')}>
    <button type="button" data-zoom="in" aria-label={t('graph.zoomIn')}>
      {/* i18n-ignore: mathematical symbols used as icons */}
      <span aria-hidden="true">+</span>
    </button>
    <button type="button" data-zoom="out" aria-label={t('graph.zoomOut')}>
      {/* i18n-ignore: mathematical symbols used as icons */}
      <span aria-hidden="true">−</span>
    </button>
    <button type="button" data-zoom="reset">{t('graph.recentre')}</button>
  </div>

  <button type="button" class="controls__clear" data-clear-selection hidden>
    {t('graph.clearSelection')}
  </button>

  <button type="button" class="controls__expand-view" data-expand-view hidden>
    {t('graph.expandView')}
  </button>

  <label class="controls__toggle">
    <input type="checkbox" data-show-all />
    <span>
      <span class="controls__toggle-label">{t('graph.showAll')}</span>
      <span class="controls__toggle-hint">{t('graph.showAllHint')}</span>
    </span>
  </label>

  <label class="controls__toggle">
    <input type="checkbox" data-show-every-relation />
    <span>
      <span class="controls__toggle-label">{t('filters.everyRelation')}</span>
      <span class="controls__toggle-hint">{t('filters.everyRelationHint')}</span>
    </span>
  </label>

  <label class="controls__toggle">
    <input type="checkbox" data-filter="disputed" />
    <span>
      <span class="controls__toggle-label">{t('filters.disputedOnly')}</span>
      <span class="controls__toggle-hint">{t('filters.disputedOnlyHint')}</span>
    </span>
  </label>

  <label class="controls__toggle">
    <input type="checkbox" data-filter="ragnarok" />
    <span>
      <span class="controls__toggle-label">{t('filters.ragnarokOverlay')}</span>
      <span class="controls__toggle-hint">{t('filters.ragnarokOverlayHint')}</span>
    </span>
  </label>
</div>

<style>
  .controls {
    position: absolute;
    inset-inline-start: var(--space-lg);
    inset-block-end: var(--space-lg);
    z-index: var(--layer-controls);
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    font-size: var(--text-sm);
  }

  /* Set by src/graph/runtime.ts once it has mounted successfully. */
  :global(html[data-graph-runtime='ready']) .controls {
    display: flex;
  }

  .controls__group {
    display: flex;
    gap: var(--space-2xs);
  }

  .controls__search {
    position: relative;
    display: grid;
    gap: var(--space-3xs);
    width: min(22rem, calc(100vw - 2 * var(--space-lg)));
    padding: var(--space-xs);
    background: color-mix(in srgb, var(--vellum-pale) 94%, transparent);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
  }

  .controls__search label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .controls__search input {
    width: 100%;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--vellum-pale);
    color: var(--ink);
    padding: var(--space-2xs) var(--space-xs);
    font: inherit;
  }

  .controls__search input:focus-visible {
    outline: 2px solid var(--verdigris);
    outline-offset: 1px;
  }

  .controls__results {
    position: absolute;
    inset-inline: 0;
    inset-block-end: calc(100% + var(--space-2xs));
    z-index: 1;
    max-height: 18rem;
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: var(--space-2xs);
    background: var(--vellum-pale);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
  }

  .controls__results[hidden] {
    display: none;
  }

  .controls__results :global([role='option']) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xs);
    padding: var(--space-2xs) var(--space-xs);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .controls__results :global([role='option'][aria-selected='true']) {
    background: var(--verdigris-wash);
    color: var(--verdigris-deep);
  }

  .controls__results :global(.search-result__non) {
    font-family: var(--font-display);
    font-size: var(--text-md);
  }

  .controls__results :global(.search-result__en) {
    color: var(--ink-faded);
    align-self: baseline;
  }

  .controls button {
    background: var(--vellum-pale);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-2xs) var(--space-xs);
    min-width: 2rem;
    cursor: pointer;
    font-size: var(--text-sm);
  }

  .controls button:hover {
    border-color: var(--verdigris);
    color: var(--verdigris-deep);
  }

  .controls__group button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--touch-target);
    min-height: var(--touch-target);
  }

  .controls__clear[hidden] {
    display: none;
  }

  .controls__clear {
    border-color: var(--verdigris) !important;
    color: var(--verdigris-deep);
    background: var(--verdigris-wash) !important;
  }

  .controls__expand-view[hidden] {
    display: none;
  }

  .controls__toggle {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    max-width: 22rem;
    cursor: pointer;
    background: color-mix(in srgb, var(--vellum-pale) 88%, transparent);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-sm);
  }

  .controls__toggle input {
    margin-top: 0.25em;
    accent-color: var(--verdigris);
  }

  .controls__toggle-label {
    display: block;
  }

  .controls__toggle-hint {
    display: block;
    font-size: var(--text-xs);
    color: var(--ink-faded);
  }
</style>
