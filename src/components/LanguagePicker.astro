---
/**
 * Language switcher.
 *
 * The endonyms are data, not translations — a switcher that renders "Japanese"
 * to an English reader is worse than one that renders 日本語 to everybody, and
 * it is the reason these strings live in config rather than in a locale file.
 */
import { ACTIVE_LOCALES, LOCALE_ENDONYMS, type Locale } from '../i18n/config.ts';
import { localePath, useTranslations } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  route: string;
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);
---

<div class="picker">
  <span class="picker__label" id="language-picker-label">{t('nav.language')}</span>
  <ul class="picker__list" aria-labelledby="language-picker-label">
    {
      ACTIVE_LOCALES.map((l) => (
        <li>
          <a
            href={localePath(l, route)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? 'true' : undefined}
            class:list={['picker__link', { 'is-current': l === locale }]}
          >
            {LOCALE_ENDONYMS[l]}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .picker {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .picker__label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-faded);
  }

  .picker__list {
    display: flex;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .picker__link.is-current {
    color: var(--ink);
    text-decoration: none;
    font-weight: var(--weight-medium);
  }
</style>
