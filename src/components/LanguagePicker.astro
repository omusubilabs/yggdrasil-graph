---
/**
 * Language switcher.
 *
 * The endonyms are data, not translations — a switcher that renders "Japanese"
 * to an English reader is worse than one that renders 日本語 to everybody, and
 * it is the reason these strings live in config rather than in a locale file.
 */
import { ACTIVE_LOCALES, LOCALE_ENDONYMS, type Locale } from '../i18n/config.ts';
import { localePath, useTranslations } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  route: string;
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);
---

<details class="picker">
  <summary
    class="picker__summary"
    aria-label={t('nav.languageCurrent', { name: LOCALE_ENDONYMS[locale] })}
  >
    <span aria-hidden="true">{LOCALE_ENDONYMS[locale]}</span>
  </summary>
  <ul class="picker__list">
    {
      ACTIVE_LOCALES.map((l) => (
        <li>
          <a
            href={localePath(l, route)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? 'true' : undefined}
            class:list={['picker__link', { 'is-current': l === locale }]}
          >
            {LOCALE_ENDONYMS[l]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  const picker = document.querySelector<HTMLDetailsElement>('.picker');

  if (picker) {
    const desktopQuery = window.matchMedia('(min-width: 40.01rem)');
    const sync = () => {
      picker.open = desktopQuery.matches;
    };

    sync();
    desktopQuery.addEventListener('change', sync);
    window.addEventListener('resize', sync);
    picker.dataset.jsReady = 'true';
  }
</script>

<style>
  .picker {
    min-width: 0;
  }

  .picker__summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-3xs) var(--space-xs);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .picker__summary::-webkit-details-marker {
    display: none;
  }

  .picker__summary::after {
    content: '▾';
    font-size: var(--text-xs);
    color: var(--ink-faded);
  }

  .picker[open] .picker__summary::after {
    content: '▴';
  }

  .picker__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
  }

  /* Chromium doesn't reliably re-hide this via native <details> behaviour once toggled open. */
  .picker:not([open]) > .picker__list {
    display: none;
  }

  .picker__link.is-current {
    color: var(--ink);
    text-decoration: none;
    font-weight: var(--weight-medium);
  }

  /* Mirrors SiteHeader.astro's 40rem breakpoint; offset by .01rem so the two
     don't fire on the same pixel. */
  @media (min-width: 40.01rem) {
    .picker[data-js-ready] .picker__summary {
      display: none;
    }

    .picker__list {
      margin: 0;
    }
  }
</style>
