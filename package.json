{
  "name": "yggdrasil-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive relationship graph of Norse mythology, built from cited primary sources.",
  "keywords": [
    "norse-mythology",
    "poetic-edda",
    "prose-edda",
    "knowledge-graph",
    "graph-visualization",
    "d3-force",
    "astro",
    "digital-humanities",
    "old-norse",
    "open-data"
  ],
  "homepage": "https://yggdrasil-graph.omusubilabs.fi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omusubilabs/yggdrasil-graph.git"
  },
  "bugs": {
    "url": "https://github.com/omusubilabs/yggdrasil-graph/issues"
  },
  "license": "MIT",
  "author": "Yuichi Ueshima",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "predev": "npm run data:build",
    "dev": "astro dev",
    "prebuild": "npm run validate && npm run data:build",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "tsx scripts/validate-data.ts",
    "data:build": "tsx scripts/build-graph.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "check:strings": "tsx scripts/check-strings.ts",
    "check:glyphs": "tsx scripts/check-glyphs.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:bundle-size": "node scripts/report-bundle-size.mjs",
    "check:target-size": "tsx scripts/check-target-size.ts",
    "check:mobile-ux": "tsx scripts/check-mobile-ux.ts",
    "test": "node --import tsx --test",
    "test:coverage": "node --import tsx --experimental-test-coverage --test",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "astro": "^7.2.9",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "fontkit": "^2.0.4",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.125.0"
  }
}
