{
  "name": "yggdrasil-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive relationship graph of Norse mythology, built from cited primary sources.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "predev": "npm run data:build",
    "dev": "astro dev",
    "prebuild": "npm run validate && npm run data:build",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "tsx scripts/validate-data.ts",
    "data:build": "tsx scripts/build-graph.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "check:strings": "tsx scripts/check-strings.ts",
    "check:glyphs": "tsx scripts/check-glyphs.ts",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/gentium-book-plus": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "astro": "^7.2.4",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "fontkit": "^2.0.4",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.125.0"
  }
}
